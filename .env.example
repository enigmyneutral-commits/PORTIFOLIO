# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NVIDIA_API_KEY: Required for NVIDIA NIM API calls (Nemotron 3.5 Bolt).
# Configured in backend environment for Enigmy Neutral Agent architecture auditing.
NVIDIA_API_KEY="nvapi-your-nvidia-api-key-here"

# NVIDIA_MODEL: Target NVIDIA NIM model.
NVIDIA_MODEL="nvidia/nemotron-3.5-bolt-e4b"

# PROVISIONAL_DOMAIN: Current provisional staging domain for the portfolio.
PROVISIONAL_DOMAIN="dmgrecords.com.br"

# RESEND_API_KEY: Required for dispatching Project Inquiry & Chat Agent Leads directly to your inbox.
# Get free key (3,000 emails/mo) at https://resend.com
RESEND_API_KEY="re_123456789_abcdefg"

# CONTACT_NOTIFICATION_EMAIL: Recipient email address for inbound leads and questionnaires.
CONTACT_NOTIFICATION_EMAIL="enigmyneutral@gmail.com"

# EMAIL_FROM: Sender identity (optional, defaults to onboarding@resend.dev during onboarding)
EMAIL_FROM="Enigmy Neutral <onboarding@resend.dev>"

